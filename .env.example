# Address of the Laravel API.
#
# IMPORTANT: this is baked into the JavaScript when you run `npm run build`, not
# read at runtime. Changing it later means rebuilding and re-uploading dist/.
#
# Development: http://127.0.0.1:8123
# Production:  https://api.example.com
VITE_API_URL=http://127.0.0.1:8123
