{
  "name": "ghaith-art",
  "compatibility_date": "2026-09-26",
  "pages_build_output_dir": "./dist",
  "placement": { "mode": "smart" },
  "limits": { "cpu_ms": 30000 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
