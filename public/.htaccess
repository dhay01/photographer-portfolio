# ---------------------------------------------------------------------------
# Apache / LiteSpeed config for the built SPA (cPanel and most shared hosts).
#
# Vite copies everything in public/ into dist/, so this ships with the build.
# On Railway it is ignored — server.js handles the same job in Node.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The router uses history mode, so /work and /blog/some-post are not files on
  # disk. Without this they 404 on refresh or when opened directly, and only
  # work when reached by clicking a link.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Vite fingerprints everything under /assets/, so it can be cached hard.
  <FilesMatch "\.(js|css|woff2|png|jpe?g|webp|avif|svg)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # index.html never is, or a deploy would not reach anyone holding a stale copy
  # that still points at the previous build's asset names.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# Cache-Control comes from mod_headers, not mod_expires. Guarding these with the
# wrong module name is a 500 on any host that has one and not the other.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpe?g|webp|avif|svg)$">
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
